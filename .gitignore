# Local data
# Raw/processed data are not committed by default. The UCI data is CC BY 4.0 and
# can be redistributed with attribution, so remove these lines if you prefer to commit it.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md
